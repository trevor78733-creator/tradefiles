# Postgres connection (Neon free tier works great: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# App password — anything visiting the site must enter this once
APP_PASSWORD="change-me"

# Used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Vercel Blob — required in production for screenshot uploads.
# Local dev falls back to public/uploads/ if unset.
# Get one from your Vercel project: Storage → Create → Blob.
BLOB_READ_WRITE_TOKEN=""
