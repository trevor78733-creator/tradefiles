# Postgres connection (Neon free tier works great: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js — JWT session secret. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Google OAuth credentials from Google Cloud Console
# Create at: https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client ID
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google  (dev)
#   https://<your-domain>/api/auth/callback/google  (prod)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Vercel Blob — required in production for screenshot uploads.
# Local dev falls back to public/uploads/ if unset.
# Get one from your Vercel project: Storage → Create → Blob.
BLOB_READ_WRITE_TOKEN=""
