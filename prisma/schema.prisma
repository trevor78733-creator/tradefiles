generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  accounts Account[]
  settings AppSetting[]
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  broker    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  trades    Trade[]

  @@index([userId])
}

enum TradeDirection {
  LONG
  SHORT
}

enum TradeResult {
  WIN
  LOSS
  BREAKEVEN
}

model Trade {
  id            String         @id @default(cuid())
  accountId     String
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol        String
  direction     TradeDirection
  contracts     Float
  entryPrice    Float?
  exitPrice     Float?
  stopPrice     Float?
  targetPrice   Float?
  pnl           Float
  result        TradeResult
  openedAt      DateTime
  closedAt      DateTime
  notes         String?
  screenshotUrl String?
  rulesFollowed String[]       @default([])
  dedupKey      String?
  importSource  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([accountId, dedupKey])
  @@index([accountId, openedAt])
  @@index([accountId, closedAt])
}

model AppSetting {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}
